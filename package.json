    "validate": "html-validate index.html page-1.html page-3.html test/fixtures/stress.html"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "html-validate": "^11.17.0"
  }
}
