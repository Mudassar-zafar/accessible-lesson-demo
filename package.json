{
  "name": "accessible-lesson-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Accessible sample eLearning lesson page and a small reusable HTML, CSS and JavaScript component library.",
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
